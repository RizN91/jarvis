# Normalise line endings so a Windows checkout and a Linux CI agree.
# The repo has had mixed LF/CRLF churn; this prevents it coming back.
* text=auto eol=lf

# Windows batch files must be CRLF or cmd.exe mis-parses them.
*.cmd text eol=crlf
*.bat text eol=crlf

# The Windows installer (install.ps1) is CRLF like the .cmd files. POSIX shell
# scripts must stay LF so their shebang keeps working.
*.ps1 text eol=crlf
*.sh  text eol=lf

# Never touch these.
*.png binary
*.mp4 binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.onnx binary
*.db binary

# Generated / vendored — collapse in diffs.
*.lock.txt linguist-generated
*.min.js linguist-generated
