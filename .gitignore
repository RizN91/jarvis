# ---------------------------------------------------------------- secrets
# NEVER commit real credentials. Jarvis stores the API key in Windows
# Credential Manager (DPAPI-wrapped) at runtime, so no key file is ever needed.
.env
.env.*
!.env.example
api.env
*.key
*.pem
*.p12
*.pfx
secrets.local.*

# ---------------------------------------------------------------- runtime data
# Created under %LOCALAPPDATA%\Jarvis at runtime. Also honoured via BV_DATA_DIR.
config.json
*.db
*.db-journal
*.db-wal
logs/
quit.request

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------- local dev / internal notes
# These are working notes for the maintainers, not part of the product.
# Kept on disk, deliberately not published.
HANDOFF.md
CODEX_AUDIT.md
AGENTS.md
docs/TEST_RESULTS_raw.txt
docs/TEST_RESULTS.md
docs/wake_tests/
docs/_vendor/
_scratch/
*.local.md

# ---------------------------------------------------------------- generated test artefacts
# Screenshots the test harness regenerates on every run. The curated set that
# IS published lives in docs/images/.
docs/codex/
docs/overlay/

# ---------------------------------------------------------------- os / editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/

# ---- demo video (video/) ----
# node_modules and the rendered output are never published.
video/node_modules/
video/out/
# Frame sequences are regenerated by video/tools/*.py, so they stay out of git.
# (public/audio/*.mp3 IS committed: it is small and makes a render reproducible
#  without needing numpy or a Python toolchain.)
video/public/pill/
video/public/live/
video/public/shots/
video/public/audio/*.wav
video/build_*.png

# Regenerated by the test suite on every run - never publish.
docs/app_startup_log.txt
docs/settings_window.png
